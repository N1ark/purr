{
  "name": "purr",
  "version": "0.5.3",
  "description": "Shared Svelte 5 components, utilities and styling for N1ark's Tauri apps",
  "type": "module",
  "private": true,
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./icons": {
      "types": "./src/icons/index.ts",
      "default": "./src/icons/index.ts"
    },
    "./vite": {
      "types": "./src/vite.d.ts",
      "default": "./src/vite.js"
    },
    "./app-icon": {
      "types": "./src/app-icon.d.ts",
      "default": "./src/app-icon.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./shell.css": "./src/styles/shell.css",
    "./styles/*": "./src/styles/*",
    "./*": {
      "types": "./src/*",
      "svelte": "./src/*",
      "default": "./src/*"
    }
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "dev": "vite",
    "build:site": "vite build",
    "preview:site": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "node scripts/release.mjs",
    "favicon": "node bin/purr-icon.js purr --out site/public --favicon --no-icon"
  },
  "peerDependencies": {
    "svelte": "^5.40.0",
    "@resvg/resvg-js": "^2.6.2"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-js": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "phosphor-svelte": "^3.1.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.0",
    "vite": "^7.3.6",
    "vitest": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/N1ark/purr.git"
  },
  "homepage": "https://n1ark.github.io/purr/",
  "bin": {
    "purr-icon": "bin/purr-icon.js"
  }
}
